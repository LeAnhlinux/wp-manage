# WP Manage API Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_MODE=development

# Database (MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=wp_manage
DB_PASSWORD=your_secure_password
DB_NAME=wp_manage

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_EXPIRATION_HOURS=24

# Panel
PANEL_DOMAIN=panel.wpm.vn
INSTALL_URL=https://install.wpm.vn
